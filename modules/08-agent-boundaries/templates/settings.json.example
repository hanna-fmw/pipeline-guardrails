{
  "_comment": "Agent boundary settings for .claude/settings.json (project) or ~/.claude/settings.json (user). Two independent layers: `sandbox` is enforced by the OS for every Bash command and its child processes; `permissions` is enforced by Claude Code for its own tool calls. You want both — the sandbox does not cover the Read/Edit/Write tools, and permission rules do not cover a subprocess spawned by a command you allowed. Verify against https://code.claude.com/docs/en/settings before copying: this is the layer most likely to have gained keys since.",

  "sandbox": {
    "enabled": true,

    "_comment_strict": "allowUnsandboxedCommands:false is the hard gate. Left true, Claude may retry a sandbox-blocked command outside the sandbox via dangerouslyDisableSandbox, which then only faces the permission prompt. failIfUnavailable stops a missing dependency from silently downgrading you to no sandbox at all.",
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,

    "_comment_autoallow": "READ THIS BEFORE ENABLING. autoAllowBashIfSandboxed defaults to TRUE: turning the sandbox on also auto-approves every sandboxed Bash command, so you trade per-command prompts for the sandbox boundary. That is the intended deal, but it is a real change — set it to false to keep prompting while still getting isolation.",
    "autoAllowBashIfSandboxed": true,

    "_comment_excluded": "Tools that genuinely cannot run sandboxed. With allowUnsandboxedCommands:false there is no escape hatch, so anything incompatible must be listed here or it is simply blocked.",
    "excludedCommands": [],

    "filesystem": {
      "_comment": "Sandboxed commands can write to the working directory and session temp dir by default. Add only what a tool genuinely needs. Do NOT set filesystem.disabled — with writes unrestricted, a command can edit shell startup files or settings.json and widen its own access on the next run.",
      "allowWrite": [
        "~/.cache",
        "~/.npm"
      ],
      "_comment_read": "Deny the whole home directory and re-open only what is needed. Enumerating sensitive paths one by one is a list you will always be behind on; this inverts it. A narrower allow re-opens part of a denied region, and an exact deny still holds inside a wider allow.",
      "denyRead": [
        "~/"
      ],
      "allowRead": [
        "."
      ]
    },

    "credentials": {
      "_comment": "Purpose-built credential layer. `deny` on a file blocks reads inside the sandbox; `deny` on an env var unsets it before each sandboxed command runs. Deny entries merge across settings scopes and only ever narrow access, so any scope can add one and none can remove another's. There is no built-in default list — only what you list here is protected.",
      "files": [
        { "path": "~/.aws/credentials", "mode": "deny" },
        { "path": "~/.ssh", "mode": "deny" },
        { "path": "~/.netrc", "mode": "deny" }
      ],
      "envVars": [
        { "name": "GITHUB_TOKEN", "mode": "deny" },
        { "name": "NPM_TOKEN", "mode": "deny" },
        { "name": "VERCEL_TOKEN", "mode": "deny" },
        { "name": "AWS_SECRET_ACCESS_KEY", "mode": "deny" },
        { "name": "STRIPE_SECRET_KEY", "mode": "deny" }
      ]
    },

    "network": {
      "_comment": "allowedDomains ALONE IS NOT AN ALLOWLIST — by default no domain is pre-allowed and a new one simply prompts, so listing domains here only skips prompts. Deny-by-default requires strictAllowlist:true, and that key is honored ONLY from user settings (~/.claude/settings.json), managed settings, or --settings. Put this block there, not in a project .claude/settings.json, or the restriction silently does not apply.",
      "strictAllowlist": true,
      "allowedDomains": [
        "registry.npmjs.org",
        "github.com",
        "api.github.com",
        "objects.githubusercontent.com"
      ]
    }
  },

  "_comment_env": "Also set CLAUDE_CODE_SUBPROCESS_ENV_SCRUB=1 in your shell profile. sandbox.credentials only strips variables from SANDBOXED commands; this strips Anthropic and cloud-provider credentials from every subprocess regardless of sandboxing.",

  "permissions": {
    "_comment": "Covers Claude's own tool calls, including the ones the sandbox never sees (Read, Edit, WebFetch). Deny always wins. Trim allow to what this project actually uses.",
    "_comment_write": "File rules are checked against Read(path) and Edit(path) ONLY. A Write(path) rule is accepted, never consulted, and warns at startup — use Edit(), which covers writes too.",
    "_comment_bypass": "A deny list is void under bypassPermissions mode. disableBypassPermissionsMode closes that hole, and belongs in managed settings where a user cannot undo it.",
    "disableBypassPermissionsMode": "disable",

    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run test:*)",
      "Bash(npm run typecheck:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm typecheck:*)"
    ],

    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(npm install:*)",
      "Bash(pnpm add:*)",
      "Bash(npx:*)",
      "Bash(gh pr create:*)",
      "Bash(dangerouslyDisableSandbox:true)",
      "WebFetch"
    ],

    "_comment_fragile": "Argument-matching Bash rules are fragile by design: `Bash(git push --force:*)` means the command STARTS WITH `git push --force`, so `git push origin main --force` does not match. Cover the common orderings, and treat the sandbox — not this list — as the real boundary.",
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git reset --hard:*)",
      "Bash(git filter-repo:*)",
      "Bash(git filter-branch:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -r -f:*)",
      "Bash(sudo:*)",

      "Bash(vercel deploy --prod:*)",
      "Bash(vercel link:*)",
      "Bash(vercel promote:*)",
      "Bash(prisma migrate deploy:*)",
      "Bash(prisma db push:*)",
      "Bash(supabase db push:*)",
      "Bash(supabase link:*)",
      "Bash(dropdb:*)",

      "Bash(env)",
      "Bash(printenv:*)",
      "Bash(claude mcp list:*)",
      "Bash(claude mcp get:*)",
      "Bash(gh auth token:*)",
      "Bash(vercel env pull:*)",
      "Bash(railway variables:*)",
      "Bash(supabase secrets list:*)",
      "Bash(wrangler secret list:*)",
      "Bash(heroku config:*)",
      "Bash(terraform output:*)",
      "Bash(docker inspect:*)",
      "Bash(kubectl get secret:*)",

      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/.claude.json)",

      "Edit(./.env)",
      "Edit(./.env.*)"
    ]
  }
}
