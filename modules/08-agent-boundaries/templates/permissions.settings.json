{
  "_comment": "Starting permission policy for .claude/settings.json (per project) or ~/.claude/settings.json (global). Rules are matched most-specific-first; deny always wins. Trim the allow list to the tools this project actually uses.",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)",
      "Bash(rg:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run test:*)",
      "Bash(npm run typecheck:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm typecheck:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(npm install:*)",
      "Bash(pnpm add:*)",
      "Bash(npx:*)",
      "Bash(docker:*)",
      "Bash(gh pr create:*)",
      "Bash(curl:*)",
      "WebFetch"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git filter-repo:*)",
      "Bash(git filter-branch:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(chmod 777:*)",

      "Bash(vercel deploy --prod:*)",
      "Bash(vercel link:*)",
      "Bash(vercel env pull:*)",
      "Bash(vercel promote:*)",
      "Bash(vercel alias:*)",

      "Bash(prisma migrate deploy:*)",
      "Bash(prisma db push:*)",
      "Bash(supabase db push:*)",
      "Bash(supabase link:*)",
      "Bash(psql:*)",
      "Bash(dropdb:*)",

      "Bash(env)",
      "Bash(printenv:*)",
      "Bash(claude mcp list:*)",
      "Bash(claude mcp get:*)",
      "Bash(gh auth token:*)",
      "Bash(op read:*)",
      "Bash(railway variables:*)",
      "Bash(supabase secrets list:*)",
      "Bash(wrangler secret list:*)",
      "Bash(heroku config:*)",
      "Bash(terraform output:*)",
      "Bash(docker inspect:*)",
      "Bash(kubectl get secret:*)",

      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.claude.json)",

      "Edit(./.env)",
      "Edit(./.env.*)",
      "Write(./.env)",
      "Write(./.env.*)"
    ]
  }
}
