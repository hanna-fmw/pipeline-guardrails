# =====================================================================
# .env.example — names + comments only, NEVER real values
# Track this file in git. Copy to .env.local and fill from 1Password.
# =====================================================================

# --- App ---
NEXT_PUBLIC_APP_URL=                   # Public origin, e.g. http://localhost:3000

# --- Database ---
DATABASE_URL=                          # Pooled connection string (Supabase pooler 6543 / connection_limit=1 for serverless)
DIRECT_URL=                            # Direct connection for migrations (Supabase direct host, IPv6 only — disconnect NetBird first)

# --- Auth ---
NEXTAUTH_SECRET=                       # Generate: openssl rand -base64 32
NEXTAUTH_URL=                          # Must match NEXT_PUBLIC_APP_URL in dev

# --- Third-party APIs ---
OPENAI_API_KEY=                        # sk-... — rotate every 90 days
STRIPE_SECRET_KEY=                     # sk_test_ in dev, sk_live_ in prod (set in Vercel/Coolify, not here)
STRIPE_WEBHOOK_SECRET=                 # whsec_... — per-environment, do NOT reuse

# --- Internal ---
SENTRY_DSN=                            # Per-project, per-environment
